# =============================================================================
#  DDD Reader / FleetView — environment configuration
#  Copy to `.env` and fill in. `.env` is git-ignored — never commit secrets.
# =============================================================================

# --- Networking --------------------------------------------------------------
# Host port the app is published on (container always listens on 8000).
APP_PORT=8000
# Gunicorn worker processes (rule of thumb: 2 × CPU cores + 1).
GUNICORN_WORKERS=2
# Only set this to "production" when serving over HTTPS — it marks the session
# cookie Secure, so the browser refuses to send it over plain HTTP (you'd get
# logged out immediately). Leave as "development" for plain-HTTP / IP access.
FLASK_ENV=development

# --- Security (CHANGE ALL OF THESE) -----------------------------------------
# Signs session cookies. Generate: openssl rand -hex 32
FLASK_SECRET_KEY=change-me-openssl-rand-hex-32
# Login passwords for the portal.
PORTAL_PASSWORD=change-me
ADMIN_PASSWORD=change-me

# --- Samsara (fleet GPS / vehicles) -----------------------------------------
# EU token from the Samsara dashboard. Leave empty to disable fleet features.
SAMSARA_API_TOKEN=

# --- HERE maps (optional, build-time) ---------------------------------------
# Enables the HERE / HERE Sat / truck-restriction map layers. Baked into the
# frontend build, so after changing it run `docker compose up -d --build`.
VITE_HERE_API_KEY=

# --- Object storage: MEGA S4 / S3-compatible (file storage) -----------------
# Needed to upload/store DDD files. Leave empty to run without remote storage.
MEGA_S4_ACCESS_KEY_ID=
MEGA_S4_SECRET_ACCESS_KEY=
MEGA_S4_BUCKET=
MEGA_S4_ENDPOINT=https://s3.g.s4.mega.io
MEGA_S4_REGION=eu-central-1

# --- OpenAI (optional AI features) ------------------------------------------
OPENAI_API_KEY=

# --- Database ----------------------------------------------------------------
# Leave empty to use the embedded SQLite file (default, simplest).
# For Postgres: uncomment the `db` service in docker-compose.yml and set:
#   DATABASE_URL=postgresql://ddd:CHANGE_ME@db:5432/ddd
DATABASE_URL=
