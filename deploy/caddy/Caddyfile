# Automatic HTTPS via Let's Encrypt. DOMAIN and ACME_EMAIL come from the
# environment (see deploy/docker-compose.caddy.yml).
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	# Match the app's 16 MB upload limit.
	request_body {
		max_size 16MB
	}
	# Behind HTTPS you can set FLASK_ENV=production in .env to mark the session
	# cookie Secure; the app sees the real scheme via this header.
	reverse_proxy app:8000 {
		header_up X-Forwarded-Proto {scheme}
	}
}
