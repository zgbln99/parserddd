# Keep the build context small and reproducible.
.git
**/node_modules
frontend/dist
**/__pycache__
*.pyc
venv/
.venv/
*.tsbuildinfo

# Local data / secrets — never bake into the image.
.env
*.env
!**/.env.example
*.db
*.sqlite
*.DDD
*.ddd
*.xlsx

# Docs / samples not needed at runtime.
*.md
!DEPLOY.md
