{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/pages/NightSimulatorPage.tsx",
    "src/pages/CompareDriversPage.tsx",
    "src/pages/VerstossePage.tsx",
    "src/pages/SettlementPage.tsx",
    "src/pages/LiveStatusPage.tsx",
    "src/pages/CompliancePage.tsx",
    "src/pages/ComplianceMonthlyPage.tsx",
    "src/features/analysis/ComplianceSection.tsx",
    "src/pages/DriverKmPage.tsx",
    "src/pages/DiagnosticsPage.tsx",
    "src/pages/SafetyEventsPage.tsx",
    "src/pages/BulkGridPage.tsx",
    "src/pages/DeadlinesPage.tsx",
    "src/pages/FuelCardsPage.tsx",
    "src/pages/SamsaraKmPage.tsx"
  ]
}
