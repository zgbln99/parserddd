# DDD Reader - Environment Variables Template
# Copy this file to .env and fill in the values

# Flask
FLASK_SECRET_KEY=change-me-to-a-random-string
FLASK_ENV=production

# Authentication passwords (CHANGE THESE!)
PORTAL_PASSWORD=change-me
ADMIN_PASSWORD=change-me

# Object storage — MEGA S4 (S3-compatible). Replaces Dropbox.
# The bucket MUST stay private; files are streamed through the backend,
# never via public URLs. Never commit real keys.
MEGA_S4_ACCESS_KEY_ID=
MEGA_S4_SECRET_ACCESS_KEY=
MEGA_S4_BUCKET=
MEGA_S4_ENDPOINT=https://s3.g.s4.mega.io
MEGA_S4_REGION=eu-central-1

# Samsara API
SAMSARA_API_TOKEN=

# Database
# Option 1: SQLite (default)
# DATABASE_FILE=/opt/ddd-reader/ddd_portal.db
#
# Option 2: PostgreSQL (set DATABASE_URL to use PostgreSQL instead of SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/ddd_reader
#
# Migration: To migrate from SQLite to PostgreSQL, set both DATABASE_FILE and DATABASE_URL, then run:
#   python -c "from database import migrate_sqlite_to_postgresql; migrate_sqlite_to_postgresql()"

# Paths (defaults work for standard deployment)
# LOGIN_HISTORY_FILE=/opt/ddd-reader/login_history.json
# USERS_FILE=/opt/ddd-reader/users.json
# ACTIVITY_LOG_FILE=/opt/ddd-reader/activity_log.json
# CONFIG_FILE=/opt/ddd-reader/config.json
# PORTAL_CACHE_FILE=/opt/ddd-reader/portal_cache.json

# Parser binary
# DDDPARSER_PATH=dddparser

# Frontend dist directory
# FRONTEND_DIR=../frontend/dist

# Company logo path for PDF exports (optional)
# COMPANY_LOGO_PATH=/opt/ddd-reader/logo.png

# OpenAI API key (for Stundenzettel OCR parsing with GPT-4o)
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=
